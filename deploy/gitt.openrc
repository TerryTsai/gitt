#!/sbin/openrc-run

name="gitt"
description="Read and create ordinary Git repositories"
command="/usr/local/bin/gitt"
command_args="${gitt_root:-/srv/git} --bind ${gitt_bind:-127.0.0.1:8080} ${gitt_args}"
command_user="gitt:git"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=5
respawn_period=60

depend() {
    need localmount
    after firewall
}
